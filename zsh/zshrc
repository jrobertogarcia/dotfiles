# ==============================================================================
# 1. Environment & PATH
# ==============================================================================
# Load shared environment (Go, Cargo, PNPM) first if present.
# Node versions are managed by fnm (initialised outside this file on Lyft machines).
[ -f ~/.shell_env ] && . ~/.shell_env

# Default Editor (prefer micro)
if command -v micro >/dev/null 2>&1; then
  export EDITOR="micro"
else
  export EDITOR="nano"
fi
export VISUAL="$EDITOR"

# Package Manager environments & PATH
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME:$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.atuin/bin:$PATH"

# ==============================================================================
# 2. Antidote & fpath
# ==============================================================================
fpath=(
  ~/.cache/antidote/github.com/zsh-users/zsh-completions/src
  $fpath
)

if [[ -f ~/.antidote/antidote.zsh ]]; then
  source ~/.antidote/antidote.zsh
  if [[ ! -f ~/.zsh_plugins.zsh || ~/.zsh_plugins.txt -nt ~/.zsh_plugins.zsh ]]; then
    antidote bundle < ~/.zsh_plugins.txt > ~/.zsh_plugins.zsh 2>/dev/null
  fi
fi

# ==============================================================================
# 3. Completion Engine (full rebuild at most every 24h; portable BSD/GNU)
# ==============================================================================
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) || ! -f ~/.zcompdump ]]; then
  compinit -i
else
  compinit -C -i
fi

# fzf must be initialised BEFORE fzf-tab so fzf-tab is the last widget bound to ^I
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git'
fi

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# macOS ships no LS_COLORS; derive it from GNU coreutils when available
if [[ -z "$LS_COLORS" ]] && command -v gdircolors >/dev/null 2>&1; then
  eval "$(gdircolors -b)"
fi

# Load compiled plugins (fzf-tab loads after compinit and fzf, before highlighting)
[[ -f ~/.zsh_plugins.zsh ]] && source ~/.zsh_plugins.zsh

# ==============================================================================
# 4. fzf-tab Configuration
# ==============================================================================
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:(cat|bat|vim|nvim|micro):*' fzf-preview 'bat --style=numbers --color=always --line-range :100 $realpath'
zstyle ':fzf-tab:*' fzf-flags --height=40% --layout=reverse

# ==============================================================================
# 5. History
# ==============================================================================
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt interactivecomments

# ==============================================================================
# 6. Tool Integrations (Starship, Zoxide, Atuin; FZF is in section 3)
# ==============================================================================
if [[ "$TERM" != "dumb" ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# ==============================================================================
# 7. Aliases
# ==============================================================================
[[ -f ~/.config/zsh/aliases.zsh ]] && source ~/.config/zsh/aliases.zsh

# ==============================================================================
# 8. Keybindings
# ==============================================================================
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word
bindkey "^[[1;3D" backward-word
bindkey "^[[1;3C" forward-word
bindkey "^[[1;5A" up-line-or-history
bindkey "^[[1;5B" down-line-or-history
